<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.poli.infrastructure.ui.Controller"
            style="-fx-background-color: #f3f5f4;">
    <top>
        <VBox spacing="4" style="-fx-background-color: #173b36;">
            <padding><Insets top="20" right="28" bottom="18" left="28"/></padding>
            <Label text="Gestión de Seguros" style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Pólizas de vida y vehículos" style="-fx-font-size: 13px; -fx-text-fill: #d3e2dc;"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="14" style="-fx-padding: 18 24 22 24;">
            <VBox spacing="12" style="-fx-background-color: white; -fx-border-color: #d9e0dd; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 16;">
                <Label text="Datos de la póliza" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #173b36;"/>
                <GridPane hgap="12" vgap="9">
                    <Label text="ID" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtId" promptText="Autogenerado" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Número de póliza" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtNumeroPoliza" promptText="POL-2026-001" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                    <Label text="Tipo" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                    <ChoiceBox fx:id="cbTipo" prefWidth="140" GridPane.columnIndex="5" GridPane.rowIndex="0"/>
                    <Label text="Asegurado" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cbAsegurado" prefWidth="230" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="2"/>
                    <Label text="Estado" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    <ChoiceBox fx:id="cbEstado" prefWidth="150" GridPane.columnIndex="4" GridPane.rowIndex="1" GridPane.columnSpan="2"/>
                    <Label text="Nombre" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtNombre" promptText="Nombre del seguro" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="2"/>
                    <Label text="Prima" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtPrima" promptText="0.00" GridPane.columnIndex="4" GridPane.rowIndex="2" GridPane.columnSpan="2"/>
                    <Label text="Descripción" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="txtDescripcion" promptText="Descripción" GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.columnSpan="5"/>
                    <Label text="Inicio (AAAA-MM-DD)" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextField fx:id="txtFechaInicio" promptText="2026-01-01" GridPane.columnIndex="1" GridPane.rowIndex="4" GridPane.columnSpan="2"/>
                    <Label text="Fin (AAAA-MM-DD)" GridPane.columnIndex="3" GridPane.rowIndex="4"/>
                    <TextField fx:id="txtFechaFin" promptText="2027-01-01" GridPane.columnIndex="4" GridPane.rowIndex="4" GridPane.columnSpan="2"/>
                </GridPane>
                <GridPane fx:id="camposVida" hgap="12" vgap="8">
                    <Label text="Beneficiario" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtBeneficiario" promptText="Nombre del beneficiario" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Cobertura" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtCobertura" promptText="0.00" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                </GridPane>
                <GridPane fx:id="camposVehiculo" hgap="12" vgap="8" visible="false" managed="false">
                    <Label text="Placa" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtPlaca" promptText="ABC123" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Marca" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtMarca" promptText="Marca" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                    <Label text="Modelo" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtModelo" promptText="Modelo" GridPane.columnIndex="5" GridPane.rowIndex="0"/>
                    <Label text="Valor asegurado" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtValorAsegurado" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="2"/>
                </GridPane>
                <HBox spacing="8">
                    <Button text="Nuevo" onAction="#nuevoSeguro"/>
                    <Button text="Guardar" onAction="#guardarSeguro" style="-fx-background-color: #28735e; -fx-text-fill: white;"/>
                    <Button text="Actualizar" onAction="#actualizarSeguro"/>
                    <Button text="Eliminar" onAction="#eliminarSeguro" style="-fx-background-color: #9d3c35; -fx-text-fill: white;"/>
                    <Label fx:id="lblResultado" text="" style="-fx-padding: 0 0 0 12; -fx-text-fill: #52645f;"/>
                </HBox>
            </VBox>
            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Pólizas" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #173b36;" HBox.hgrow="ALWAYS"/>
                    <ChoiceBox fx:id="cbCriterio" prefWidth="105"/>
                    <TextField fx:id="txtBusqueda" promptText="Número de póliza o ID" onAction="#buscarSeguro" prefWidth="220"/>
                    <Button text="Buscar" onAction="#buscarSeguro"/>
                    <Button text="Ver todas" onAction="#listarTodos"/>
                </HBox>
                <TableView fx:id="tblSeguros" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="55"/>
                        <TableColumn fx:id="colPoliza" text="Póliza" prefWidth="150"/>
                        <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100"/>
                        <TableColumn fx:id="colAsegurado" text="Asegurado" prefWidth="190"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                        <TableColumn fx:id="colVigencia" text="Vigencia" prefWidth="220"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>

@startuml
!pragma layout smetana
skinparam componentStyle rectangle

package "co.edu.poli.aplication.domain.model" {
  [Seguro abstracto]
  [SeguroVida]
  [SeguroVehiculo]
  [Asegurado]
  [EstadoSeguro]
  [SeguroVida] --|> [Seguro abstracto]
  [SeguroVehiculo] --|> [Seguro abstracto]
  [Seguro abstracto] --> [Asegurado]
  [Seguro abstracto] --> [EstadoSeguro]
}
package "co.edu.poli.aplication.port.in" {
  interface "CrearSeguroUseCase" as Crear
  interface "ConsultarSeguroPorIdUseCase" as ConsultarId
  interface "ConsultarSeguroPorPolizaUseCase" as ConsultarPoliza
  interface "ListarSegurosUseCase" as Listar
  interface "ActualizarSeguroUseCase" as Actualizar
  interface "EliminarSeguroUseCase" as Eliminar
  interface "ListarAseguradosUseCase" as ListarAsegurados
}
package "co.edu.poli.aplication.service" {
  [CrearSeguroService] as CrearService
  [ConsultarSeguroPorIdService] as ConsultarIdService
  [ConsultarSeguroPorPolizaService] as ConsultarPolizaService
  [ListarSegurosService] as ListarService
  [ActualizarSeguroService] as ActualizarService
  [EliminarSeguroService] as EliminarService
  [ListarAseguradosService] as ListarAseguradosService
}
package "co.edu.poli.aplication.port.out" {
  interface "SeguroRepository" as Repo
}
package "co.edu.poli.infrastructure" {
  [Controller JavaFX] as Controller
  [MysqlSeguroRepository JDBC] as MysqlRepository
  [MySQL] as MySQL
}

Controller --> Crear
Controller --> ConsultarId
Controller --> ConsultarPoliza
Controller --> Listar
Controller --> Actualizar
Controller --> Eliminar
Controller --> ListarAsegurados
Crear <|.. CrearService
ConsultarId <|.. ConsultarIdService
ConsultarPoliza <|.. ConsultarPolizaService
Listar <|.. ListarService
Actualizar <|.. ActualizarService
Eliminar <|.. EliminarService
ListarAsegurados <|.. ListarAseguradosService
CrearService --> Repo
ConsultarIdService --> Repo
ConsultarPolizaService --> Repo
ListarService --> Repo
ActualizarService --> Repo
EliminarService --> Repo
ListarAseguradosService --> Repo
MysqlRepository ..|> Repo
MysqlRepository --> MySQL

note right of Repo
  Los servicios dependen de este puerto,
  nunca de MysqlSeguroRepository.
end note
@enduml
